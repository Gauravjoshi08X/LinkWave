---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav container">
    <a href="/" class="logo">
      <img 
        src="/logo.png" 
        alt="Link Wave Global Study" 
        width="180" 
        height="45"
        class="logo-image"
      />
    </a>
    
    <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class:list={["nav-link", { active: currentPath === '/' }]}>Home</a></li>
      <li><a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>Why Choose Us?</a></li>
      
      <!-- Study Abroad Dropdown -->
      <li class="dropdown">
        <button class="nav-link dropdown-toggle" aria-expanded="false">
          Study Abroad <span class="dropdown-arrow">▾</span>
        </button>
        <div class="dropdown-menu mega-menu">
          <div class="mega-menu-grid">
            <div class="mega-column">
              <h4>International</h4>
              <ul>
                <li><a href="/study-in-australia">Australia</a></li>
                <li><a href="/study-in-u-k">United Kingdom</a></li>
                <li><a href="/study-in-canada">Canada</a></li>
                <li><a href="/study-in-new-zealand">New Zealand</a></li>
                <li><a href="/study-in-u-s">United States</a></li>
              </ul>
            </div>
            <div class="mega-column">
              <h4>Europe</h4>
              <ul>
                <li><a href="/study-in-france">France</a></li>
                <li><a href="/study-in-ireland">Ireland</a></li>
                <li><a href="/study-in-finland">Finland</a></li>
                <li><a href="/study-in-denmark">Denmark</a></li>
                <li><a href="/study-in-germany">Germany</a></li>
                <li><a href="/study-in-the-netherlands">Netherlands</a></li>
                <li><a href="/study-in-malta">Malta</a></li>
              </ul>
            </div>
            <div class="mega-column">
              <h4>Asia</h4>
              <ul>
                <li><a href="/study-in-india">India</a></li>
                <li><a href="/study-in-japan">Japan</a></li>
                <li><a href="/study-in-philippines">Philippines</a></li>
              </ul>
            </div>
          </div>
        </div>
      </li>
      
      <!-- Test Preparation Dropdown -->
      <li class="dropdown">
        <button class="nav-link dropdown-toggle" aria-expanded="false">
          Test Preparation <span class="dropdown-arrow">▾</span>
        </button>
        <div class="dropdown-menu simple-menu">
          <ul>
            <li><a href="/test-preparation/ielts">IELTS Preparation</a></li>
            <li><a href="/test-preparation/pte">PTE Preparation</a></li>
            <li><a href="/test-preparation/duolingo">Duolingo Test</a></li>
          </ul>
        </div>
      </li>
      
      <li><a href="/news" class:list={["nav-link", { active: currentPath === '/news' }]}>News</a></li>
      <li><a href="/contact-us" class:list={["nav-link", { active: currentPath === '/contact-us' }]}>Contact Us</a></li>
      <li><a href="/contact-us" class="nav-cta btn btn-primary">Apply</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    background: var(--primary-white);
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 5rem;
    position: relative;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    z-index: 1001;
  }

  .logo-image {
    height: 42px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    align-items: center;
    margin-left: auto;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all var(--transition);
    font-size: 0.95rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--tertiary);
    background: rgba(101, 45, 144, 0.05);
  }

  .nav-link.active {
    color: var(--tertiary);
    font-weight: 600;
  }

  .nav-cta {
    margin-left: 0.5rem;
    padding: 0.5rem 1.25rem !important;
    font-size: 0.9rem !important;
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .dropdown-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
    background: var(--primary-white);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    padding: 2rem;
    border: 1px solid var(--gray-200);
    pointer-events: none;
  }

  .dropdown:hover .dropdown-menu,
  .dropdown.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: all;
  }

  .dropdown:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .mega-menu {
    width: 700px;
  }

  .mega-menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mega-column h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--tertiary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--gray-200);
  }

  .mega-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mega-column a {
    text-decoration: none;
    color: var(--text-dark);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    display: block;
    font-size: 0.9rem;
    transition: all 0.15s;
  }

  .mega-column a:hover {
    background: rgba(101, 45, 144, 0.06);
    color: var(--tertiary);
    padding-left: 1rem;
  }

  .simple-menu {
    width: 280px;
    padding: 0.75rem;
  }

  .simple-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .simple-menu a {
    text-decoration: none;
    color: var(--text-dark);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.15s;
  }

  .simple-menu a:hover {
    background: rgba(101, 45, 144, 0.06);
    color: var(--tertiary);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .mobile-toggle span {
    width: 24px;
    height: 2.5px;
    background: var(--secondary);
    border-radius: 2px;
    transition: all 0.3s;
    display: block;
  }

  /* Mobile Styles */
  @media (max-width: 1024px) {
    .mega-menu {
      width: auto;
      left: 0;
      right: 0;
      transform: translateX(0) translateY(10px);
    }
    
    .dropdown:hover .dropdown-menu {
      transform: translateX(0) translateY(0);
    }
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .mobile-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .mobile-toggle.active span:nth-child(2) {
      opacity: 0;
    }
    .mobile-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }
    
    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--primary-white);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      gap: 0.5rem;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      box-shadow: none;
      max-height: 100vh;
      overflow-y: auto;
      z-index: 999;
      text-align: center;
    }

    .nav-links.active {
      transform: translateX(0);
      box-shadow: -5px 0 40px rgba(0, 0, 0, 0.2);
    }

    .nav-link {
      font-size: 1.2rem;
      padding: 0.75rem 1rem;
      width: 100%;
      max-width: 300px;
      text-align: center;
    }

    .dropdown {
      width: 100%;
      max-width: 300px;
    }

    .dropdown-toggle {
      width: 100%;
      justify-content: center;
      font-size: 1.2rem;
      padding: 0.75rem 1rem;
    }

    .mega-menu,
    .simple-menu {
      position: static;
      box-shadow: none;
      border: none;
      padding: 0;
      background: var(--gray-100);
      border-radius: 10px;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      width: 100%;
      margin: 0.25rem 0 0.5rem;
    }

    .dropdown.open .mega-menu,
    .dropdown.open .simple-menu {
      display: block;
    }

    .mega-menu-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1rem;
    }

    .mega-column h4 {
      text-align: center;
    }

    .mega-column a,
    .simple-menu a {
      text-align: center;
      padding: 0.5rem 1rem;
    }

    .dropdown-menu {
      pointer-events: all;
    }

    .dropdown:hover .dropdown-menu {
      display: none;
    }

    .nav-cta {
      margin-left: 0;
      margin-top: 1rem;
      max-width: 300px;
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  const mobileToggle = document.getElementById('mobileToggle');
  const navLinks = document.getElementById('navLinks');
  const dropdownToggles = document.querySelectorAll('.dropdown-toggle');

  // Toggle mobile menu
  mobileToggle.addEventListener('click', () => {
    mobileToggle.classList.toggle('active');
    navLinks.classList.toggle('active');
    document.body.style.overflow = navLinks.classList.contains('active') ? 'hidden' : '';
  });

  // Handle dropdowns on mobile
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        const dropdown = toggle.closest('.dropdown');
        
        // Close other dropdowns
        document.querySelectorAll('.dropdown.open').forEach(d => {
          if (d !== dropdown) d.classList.remove('open');
        });
        
        dropdown.classList.toggle('open');
      }
    });
  });

  // Close menu when clicking a link
  navLinks.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) {
        mobileToggle.classList.remove('active');
        navLinks.classList.remove('active');
        document.body.style.overflow = '';
        document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
      }
    });
  });

  // Close menu on window resize
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768) {
      mobileToggle.classList.remove('active');
      navLinks.classList.remove('active');
      document.body.style.overflow = '';
      document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
    }
  });
</script>