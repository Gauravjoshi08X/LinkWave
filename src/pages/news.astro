---
import MainLayout from '../layouts/MainLayout.astro';
import { fetchNews } from '../utils/strapi.js';

const news = await fetchNews();
---

<MainLayout
  title="Latest News & Updates"
  description="Stay updated with the latest news about studying abroad, visa updates, and educational opportunities."
>
  <div class="container" style="padding: 4rem 1.5rem;">
    <h1 class="reveal">Latest News</h1>
    <div class="news-list">
      {news.map(item => (
        <article class="news-card reveal" id={item.id}>
          {item.bannerUrl && <img src={item.bannerUrl} alt={item.bannerAlt} loading="lazy" />}
          <div class="news-content">
            <span class="category">{item.category}</span>
            <h2>{item.title}</h2>
            <time datetime={item.timestamp}>{new Date(item.timestamp).toLocaleDateString()}</time>
          </div>
        </article>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .news-list {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  .news-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    background: var(--gray-100);
    border-radius: 12px;
    overflow: hidden;
  }
  .news-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-content {
    padding: 1.5rem;
  }
  .category {
    display: inline-block;
    background: var(--tertiary);
    color: var(--primary-white);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  @media (max-width: 600px) {
    .news-card {
      grid-template-columns: 1fr;
    }
  }
</style>