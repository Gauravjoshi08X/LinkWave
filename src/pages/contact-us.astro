---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contact LinkWave Education"
  description="Get in touch with our education consultants for personalized guidance."
>
  <div class="container" style="padding: 4rem 1.5rem; max-width: 600px;">
    <h1 class="reveal">Contact Us</h1>
    <form class="contact-form reveal">
      <input type="text" placeholder="Your Name" required />
      <input type="email" placeholder="Your Email" required />
      <select name="destination">
      <option value="">Select your Destination</option>
      <option value="Australia">Australia</option>
      <option value="UK">United Kingdom</option>
      <option value="Canada">Canada</option>
      <option value="New Zealand">New Zealand</option>
      <option value="USA">United States</option>
      </select>
      <textarea placeholder="Your Message" rows="5"></textarea>
      <button type="submit" class="btn btn-primary">Send Message</button>
    </form>
  </div>
</MainLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    padding: 0.75rem;
    border: 2px solid var(--gray-200);
    border-radius: 8px;
    font-family: inherit;
  }
</style>