---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contact LinkWave Education"
  description="Get in touch with our education consultants for personalized guidance."
>
  <div class="container" style="padding: 4rem 1.5rem; max-width: 600px;">
    <h1 class="reveal">Contact Us</h1>
    <form class="contact-form reveal">
      <input type="text" name='name' placeholder="Your Name" required />
      <input type="email" name='email' placeholder="Your Email" required />
      <input type="text" name='phone' placeholder="Your Phone" required />

      <select name="course">
      <option value="">Select Preferred Course</option>
      <option value="IELTS Exams Preparation">IELTS Exams Preparation</option>
      <option value="PTE Exams Preparation">PTE Exams Preparation</option>
      <option value="Duolingo">Duolingo</option>
      <option value="Japanese Language Study Guide">Japanese Language Study Guide</option>
      </select>

      <select name="destination">
      <option value="">Select your Destination</option>
      <option value="Australia">Australia</option>
      <option value="UK">United Kingdom</option>
      <option value="Canada">Canada</option>
      <option value="New Zealand">New Zealand</option>
      <option value="USA">United States</option>
      </select>

      <textarea name="message" placeholder="Your Message" rows="5"></textarea>
      <button type="submit" class="btn btn-primary">Send Message</button>
    </form>
  </div>
</MainLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    padding: 0.75rem;
    border: 2px solid var(--gray-200);
    border-radius: 8px;
    font-family: inherit;
  }
</style>
<script>
  const form = document.querySelector('.contact-form');
  const statusDiv = document.createElement('div');
  statusDiv.style.cssText = 'display:none; margin-top:1rem; padding:1rem; border-radius:8px; text-align:center;';
  form.appendChild(statusDiv);

  let isSubmitting = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Rate limiting - prevent double submission
    if (isSubmitting) {
      statusDiv.style.display = 'block';
      statusDiv.style.background = '#fff3cd';
      statusDiv.style.color = '#856404';
      statusDiv.textContent = 'Please wait 5 seconds before sending again.';
      return;
    }

    // Use FormData to get ALL form fields automatically
    const rawData = new FormData(form);
    const name = rawData.get('name')?.trim() || '';
    const email = rawData.get('email')?.trim() || '';
    const phone = rawData.get('phone')?.trim() || '';
    const destination = rawData.get('destination') || '';
    const course = rawData.get('course') || '';
    const message = rawData.get('message')?.trim() || '';

    // Validate
    if (!name || !email) {
      statusDiv.style.display = 'block';
      statusDiv.style.background = '#fff3cd';
      statusDiv.style.color = '#856404';
      statusDiv.textContent = !name ? 'Please enter your name.' : 'Please enter your email.';
      return;
    }

    // Disable button and set submitting flag
    isSubmitting = true;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    submitBtn.style.opacity = '0.7';
    submitBtn.style.cursor = 'not-allowed';

    const formData = {
      data: {
        name,
        email,
        phone,
        destination,
        course,
        message,
      }
    };

    try {
      statusDiv.style.display = 'block';
      statusDiv.style.background = '#e3f2fd';
      statusDiv.style.color = '#1565c0';
      statusDiv.textContent = 'Sending your message...';

      const response = await fetch('https://authentic-bracelet-0264bec354.strapiapp.com/api/contacts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
      });

      if (response.ok) {
        statusDiv.style.background = '#e8f5e9';
        statusDiv.style.color = '#2e7d32';
        statusDiv.textContent = 'Message sent successfully! We will contact you within 24 hours.';
        form.reset();
      } else {
        const errorData = await response.json();
        console.error('Strapi error:', errorData);
        throw new Error(errorData.error?.message || 'Failed to submit');
      }
    } catch (error) {
      console.error('Submit error:', error);
      statusDiv.style.background = '#ffebee';
      statusDiv.style.color = '#c62828';
      statusDiv.textContent = 'Unable to send message. Please call us at +977-9851410481.';
    } finally {
      // Re-enable after 5 seconds
      setTimeout(() => {
        isSubmitting = false;
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
      }, 5000);
    }
  });
</script>