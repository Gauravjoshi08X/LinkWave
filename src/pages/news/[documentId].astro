---
import MainLayout from '../../layouts/MainLayout.astro';
import { fetchSingleNews, fetchNews } from '../../utils/strapi.js';

export async function getStaticPaths() {
  const news = await fetchNews();
  console.log('News items found:', news.length);
  console.log('Document IDs:', news.map(n => n.documentId));
  
  return news.map(item => ({
    params: { documentId: item.documentId }
  }));
}

const { documentId } = Astro.params;
console.log('Requested documentId:', documentId);

const article = await fetchSingleNews(documentId);
console.log('Article found:', article ? article.title : 'Not found');

if (!article) {
  return Astro.redirect('/news');
}

function simpleMarkdown(text) {
  if (!text) return '';
  
  return text
    .replace(/^### (.+)$/gm, '<h4>$1</h4>')
    .replace(/^## (.+)$/gm, '<h3>$1</h3>')
    .replace(/^# (.+)$/gm, '<h2>$1</h2>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    .replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>')
    .replace(/^\d+\.\s+(.+)$/gm, '<li>$1</li>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br/>');
}
---

<MainLayout title={article.title} description={article.description?.replace(/[#*]/g, '').substring(0, 160)}>
  <article class="single-news">
    <div class="news-banner">
      {article.bannerUrl ? (
        <img src={article.bannerUrl} alt={article.bannerAlt} />
      ) : (
        <div class="banner-placeholder">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
      )}
    </div>

    <div class="article-container">
      <div class="article-header">
        <span class="article-category">{article.category}</span>
        <h1>{article.title}</h1>
        <div class="article-meta">
          <time datetime={article.timestamp}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {article.timestamp ? new Date(article.timestamp).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
          </time>
        </div>
      </div>

      <div class="article-body">
        {article.description ? (
          <Fragment set:html={simpleMarkdown(article.description)} />
        ) : (
          <p>No content available.</p>
        )}
      </div>

      <div class="article-footer">
        <a href="news" class="btn btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to All News
        </a>
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .single-news { background-color: rgb(231, 246, 255); }
  
  .news-banner {
    width: 100%;
    max-height: 500px;
    overflow: hidden;
    background: var(--gray-100);
  }
  .news-banner img {
    width: 100%;
    object-fit: cover;
    background-position: top;
  }
  .banner-placeholder {
    width: 100%;
    height: 300px;
    background: linear-gradient(135deg, var(--secondary), var(--tertiary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
  }

  .article-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }
  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gray-200);
  }
  .article-category {
    display: inline-block;
    background: var(--tertiary);
    color: var(--primary-white);
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }
  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .article-meta time {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #888;
    font-size: 0.9rem;
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: var(--secondary);
  }
  .article-body :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
    color: var(--secondary);
  }
  .article-body :global(h4) {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--tertiary);
  }
  .article-body :global(p) {
    font-size: 1.1rem;
    line-height: 1.9;
    color: #333;
    margin-bottom: 1.25rem;
  }
  .article-body :global(strong) {
    color: var(--secondary);
    font-weight: 700;
  }
  .article-body :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .article-body :global(li) {
    font-size: 1.1rem;
    line-height: 1.9;
    color: #444;
    margin-bottom: 0.5rem;
  }
  .article-body :global(li::marker) {
    color: var(--tertiary);
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gray-200);
  }
  .article-footer .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .news-banner img { height: 250px; }
    
    .article-container {
      padding: 2rem 1.25rem 4rem;
    }
    
    .article-body :global(p), .article-body :global(li) { font-size: 1.05rem; }
  }
</style>