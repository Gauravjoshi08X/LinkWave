---
import MainLayout from '../layouts/MainLayout.astro';
import { fetchNews } from '../utils/strapi.js';

const news = await fetchNews();
---

<MainLayout
  title="Link Wave Global Study | Expert Study Abroad Consultancy in Nepal"
  description="Your trusted partner for international education. Expert IELTS, PTE preparation & visa processing for Australia, UK, Canada, USA, Japan & more. Based in Putalisadak, Kathmandu."
>
  <!-- Hero Section -->
  <section class="hero">
    <!-- Background Image Container -->
    <div class="hero-bg">
      <img 
        src="home.jpeg" 
        alt="Link Wave Global Study Office"
        class="hero-bg-image"
      />
    </div>
    
    <!-- Dark Overlay -->
    <div class="hero-overlay"></div>
    
    <!-- Content -->
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <span class="pretitle">Link Wave Global Study</span>
        <h1>Where Ideas <span class="highlight">Link Up</span></h1>
        <p class="hero-description">Your trusted partner for international education. We guide Nepali students to top universities across 10+ countries with expert counseling, test preparation, and visa assistance.</p>
        <div class="hero-actions">
          <a href="/contact-us" class="btn btn-primary">Consult Now</a>
          <a href="https://wa.me/9779851410481?text=Hello%20Link%20Wave%20Global%20Study!%20I%20would%20like%20to%20know%20more%20about%20studying%20abroad." 
             target="_blank" 
             rel="noopener noreferrer" 
             class="btn btn-outline-white">
            WhatsApp Us
          </a>
        </div>
          <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">5+</span>
            <span class="stat-label">Countries</span>
          </div>
          <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Universities</span>
          </div>
          <div class="stat">
            <span class="stat-number">100+</span>
            <span class="stat-label">Success Stories</span>
          </div>
          <div class="stat">
            <span class="stat-number">10+</span>
            <span class="stat-label">Years Experience</span>
          </div>
        </div>
      </div> 
  </section>

  <!-- Destinations -->
  <section class="section">
    <div class="container">
      <div class="section-intro reveal">
        <h2>Find the Right Destination</h2>
        <p>Expert guidance for top study destinations with over 500 leading institutions worldwide</p>
      </div>

      <div class="destinations-grid reveal">
        <a href="/study-in-u-s" class="dest-card">
          <div class="dest-card-bg" style="background-image: url('us.jpeg')"></div>
          <div class="dest-card-overlay"></div>
          <div class="dest-card-content">
            <h3>United States</h3>
            <p class="dest-unis">Harvard, MIT, Stanford, Columbia, UC Berkeley</p>
          </div>
        </a>

        <a href="/study-in-u-k" class="dest-card">
          <div class="dest-card-bg" style="background-image: url('uk.jpeg')"></div>
          <div class="dest-card-overlay"></div>
          <div class="dest-card-content">
            <h3>United Kingdom</h3>
            <p class="dest-unis">Oxford, Cambridge, Imperial, UCL, Edinburgh</p>
          </div>
        </a>

        <a href="/study-in-canada" class="dest-card">
          <div class="dest-card-bg" style="background-image: url('canada.jpeg')"></div>
          <div class="dest-card-overlay"></div>
          <div class="dest-card-content">
            <h3>Canada</h3>
            <p class="dest-unis">Toronto, UBC, McGill, Alberta, Waterloo</p>
          </div>
        </a>

        <a href="/study-in-australia" class="dest-card">
          <div class="dest-card-bg" style="background-image: url('aus.jpeg')"></div>
          <div class="dest-card-overlay"></div>
          <div class="dest-card-content">
            <h3>Australia</h3>
            <p class="dest-unis">Melbourne, Sydney, ANU, UQ, UNSW</p>
          </div>
        </a>

        <a href="/study-in-new-zealand" class="dest-card">
          <div class="dest-card-bg" style="background-image: url('nz.jpeg')"></div>
          <div class="dest-card-overlay"></div>
          <div class="dest-card-content">
            <h3>New Zealand</h3>
            <p class="dest-unis">Auckland, Otago, Victoria, Canterbury, Massey</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-intro reveal">
        <h2>Our Services</h2>
        <p>We Provide The Following Services</p>
      </div>

      <div class="services-grid">
        <!-- PTE -->
        <div class="service-card reveal">
          <div class="service-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
            </svg>
          </div>
          <h3>PTE Exam Preparation</h3>
          <p>Our PTE exam preparation program is designed to help students achieve high scores through expert guidance, structured lessons, and real-time practice tests. We focus on all four modules—Speaking, Writing, Reading, and Listening.</p>
          <a href="/test-preparation/pte" class="read-more">Read More →</a>
        </div>

        <!-- IELTS -->
        <div class="service-card reveal">
          <div class="service-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
              <line x1="8" y1="7" x2="16" y2="7"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3>IELTS Exam Preparation</h3>
          <p>Our IELTS coaching provides in-depth training for both Academic and General Training modules, helping students build strong language skills. With experienced instructors, mock tests, study materials, and personalized strategies, we ensure you gain confidence and fluency in English.</p>
          <a href="/test-preparation/ielts" class="read-more">Read More →</a>
        </div>

        <!-- Duolingo -->
        <div class="service-card reveal">
          <div class="service-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3>Duolingo English Test</h3>
          <p>The Duolingo English Test (DET) is a fast, affordable, and convenient online English proficiency exam, designed for students and professionals who need to demonstrate their language skills for study, work, or migration.</p>
          <a href="/test-preparation/duolingo" class="read-more">Read More →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional Services -->
  <section class="section">
    <div class="container">
      <div class="section-intro reveal">
        <h2>Additional Services</h2>
        <p>We Also Offer</p>
      </div>

      <div class="additional-services reveal">
        <p class="services-intro">At Link Wave Global Study, we offer comprehensive services to help students achieve their dream of studying abroad. From expert coaching in IELTS, PTE, and other language proficiency tests to personalized study abroad consultation, we guide you in choosing the right university and destination. Our team provides complete application assistance, including SOP writing, recommendation letters, and document preparation. We also offer visa guidance, scholarship assistance, and financial aid support to make education more accessible. With pre-departure and post-arrival support, we ensure a smooth transition to your new academic journey.</p>
        
        <div class="service-list">
          <div class="service-item">
            <span class="check-icon">✓</span>
            <span>Career Counseling</span>
          </div>
          <div class="service-item">
            <span class="check-icon">✓</span>
            <span>Accommodation Assistance</span>
          </div>
          <div class="service-item">
            <span class="check-icon">✓</span>
            <span>Part-Time Job Guidance</span>
          </div>
          <div class="service-item">
            <span class="check-icon">✓</span>
            <span>University Interview Preparation</span>
          </div>
          <div class="service-item">
            <span class="check-icon">✓</span>
            <span>Post-Study Career Support</span>
          </div>
        </div>

        <a href="/about" class="btn btn-primary">Know More</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-intro reveal">
        <h2>Why Choose Us?</h2>
      </div>

      <div class="features-grid">
        <div class="feature-card reveal">
          <h3>Multiple Destinations</h3>
          <p>We offer expert guidance for studying in various countries, giving you more choices for your future.</p>
        </div>

        <div class="feature-card reveal">
          <h3>End to End Service</h3>
          <p>From consultation to visa approval, we assist you at every step for a hassle-free experience.</p>
        </div>

        <div class="feature-card reveal">
          <h3>Experienced Team</h3>
          <p>Our skilled professionals ensure accurate advice and support tailored to your needs.</p>
        </div>

        <div class="feature-card reveal">
          <h3>Quick Service</h3>
          <p>We prioritize efficiency to help you meet deadlines without unnecessary delays.</p>
        </div>

        <div class="feature-card reveal">
          <h3>Document Preparation Guidance</h3>
          <p>Our experts assist in preparing flawless documents to strengthen your application.</p>
        </div>

        <div class="feature-card reveal">
          <h3>Scholarship Assistance</h3>
          <p>We help you find and apply for scholarships, making education more affordable.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="container">
      <div class="section-intro reveal">
        <h2>What People Say About Us</h2>
        <p>Hear from our successful students who achieved their dreams</p>
      </div>

      <div class="testimonials-grid">
        <div class="testimonial-card reveal">
          <div class="testimonial-header">
            <div class="testimonial-avatar">RY</div>
            <div>
              <strong>Rakesh Yadav</strong>
              <span class="testimonial-dest">Studying in UK</span>
            </div>
          </div>
          <p class="testimonial-text">"I had an amazing experience with Link Wave Global Study. The team was very supportive and helped me throughout my IELTS preparation. Thanks to their expert coaching, I was able to achieve my desired band score. Highly recommend their services!"</p>
        </div>

        <div class="testimonial-card reveal">
          <div class="testimonial-header">
            <div class="testimonial-avatar">PP</div>
            <div>
              <strong>Pradeep Prasad</strong>
              <span class="testimonial-dest">Studying in UK</span>
            </div>
          </div>
          <p class="testimonial-text">"I approached Link Wave Global Study for my overseas study application, and they guided me through every step smoothly. Their insights on visa interviews and documentation were extremely helpful. Would definitely recommend them to students looking to study abroad."</p>
        </div>

        <div class="testimonial-card reveal">
          <div class="testimonial-header">
            <div class="testimonial-avatar" style="background: #2d6a4f;">PK</div>
            <div>
              <strong>Parikshid</strong>
              <span class="testimonial-dest">Studying in UK</span>
            </div>
          </div>
          <p class="testimonial-text">"Big thanks to Link Wave Global Study for making my UK study journey smooth and successful! Their guidance through admissions and visa was spot on. Truly appreciate their support every step of the way!"</p>
        </div>

        <div class="testimonial-card reveal">
          <div class="testimonial-header">
            <div class="testimonial-avatar" style="background: #9b2226;">BP</div>
            <div>
              <strong>Bedraj Phuyal</strong>
              <span class="testimonial-dest">Regent College</span>
            </div>
          </div>
          <p class="testimonial-text">"The guidance I received for my study abroad process was outstanding. They helped me choose the right university, prepared my documents, and even assisted with my visa. The staff is professional and truly cares about students' futures."</p>
        </div>
      </div>
  </section>

  <!-- News Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-intro reveal">
        <h2>Blogs & News</h2>
      </div>

      {news.length > 0 ? (
        <div class="news-grid">
          {news.slice(0, 4).map(item => (
            <a href={`/news/${item.documentId}`} class="news-card reveal">
              {item.bannerUrl && (
                <img 
                  src={item.bannerUrl} 
                  alt={item.bannerAlt} 
                  loading="lazy"
                  width={item.bannerWidth}
                  height={item.bannerHeight}
                />
              )}
              <div class="news-card-content">
                <h3>{item.title}</h3>
                <time datetime={item.timestamp}>
                  {new Date(item.timestamp).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric'
                  })}
                </time>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="news-grid">
        </div>
      )}
    </div>
  </section>

  <!-- Map / Location CTA -->
  <a href="https://maps.google.com/?q=Link+Wave+Global+Study+Putalisadak+Kathmandu+Nepal" 
     target="_blank" 
     rel="noopener noreferrer"
     class="map-cta reveal">
    <div class="container">
      <div class="map-cta-content">
        <div class="map-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div class="map-text">
          <h2>Visit Our Office</h2>
          <p>Putalisadak, Kathmandu, Nepal (Head Office)</p>
          <span class="map-link">Open in Google Maps →</span>
        </div>
      </div>
    </div>
  </a>
  <!-- Free Consultation -->
  <section class="section consultation-section">
    <div class="container">
      <div class="consultation-wrapper reveal">
        <div class="consultation-info">
          <h2>Don't Know What To Start With?</h2>
          <p>Get all solutions for your journey from language preparation to VISA.</p>
          
          <div class="office-details">
            <div class="office-item">
              <strong>Office</strong>
              <p>Putalisadak, Kathmandu, Nepal (Head Office)</p>
              <p>Jadibuti, Bhaktapur, Nepal (Branch)</p>
            </div>
            <div class="office-item">
              <strong>Phone</strong>
              <p>+(977) 01-4538899<br/>+(977) 9851410481</p>
            </div>
            <div class="office-item">
              <strong>Email</strong>
              <p>hello@linkwaveedu.com</p>
            </div>
          </div>
        </div>
        <div class="consultation-form-wrapper">
          <h3>Free Consultation</h3>
          <p>Schedule a counselling now.</p>
          <form class="consultation-form" id="consultationForm">
            <div class="form-row">
              <input type="text" name="first" placeholder="First Name" required />
              <input type="text" name="last" placeholder="Last Name" required />
            </div>
            <input type="tel" name="phone" placeholder="Phone Number" required />
            <input type="email" name="email" placeholder="Email Address" />
            <select name="destination">
              <option value="">Select your Destination</option>
              <option value="Australia">Australia</option>
              <option value="UK">United Kingdom</option>
              <option value="Canada">Canada</option>
              <option value="USA">United States</option>
              <option value="New Zealand">New Zealand</option>
            </select>
            <select name="course">
              <option value="">Preferred Course</option>
              <option value="IELTS">IELTS Preparation</option>
              <option value="PTE">PTE Preparation</option>
              <option value="Duolingo">Duolingo Test</option>
              <option value="Japanese">Japanese</option>
            </select>
            <textarea name="message" placeholder="Your Message" rows="3"></textarea>
            <button type="submit" class="btn btn-primary btn-full">Submit</button>
          </form>
          <div id="consultationStatus" style="display:none; margin-top:1rem; padding:0.75rem; border-radius:8px; text-align:center; font-size:0.9rem;"></div>
          <div style="text-align:center; margin-top:1rem;">
            <span style="color:#888; font-size:0.85rem;">or</span><br/>
            <a href="https://wa.me/9779851410481?text=Hello%20Link%20Wave!%20I%20need%20free%20consultation%20for%20studying%20abroad." 
               target="_blank" 
               rel="noopener noreferrer" 
               style="display:inline-flex; align-items:center; gap:0.5rem; color:#25D366; font-weight:600; text-decoration:none; margin-top:0.5rem; font-size:0.9rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
  const consultationForm = document.getElementById('consultationForm');
  const consultationStatus = document.getElementById('consultationStatus');

  consultationForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const rawData = new FormData(consultationForm);
    const firstName = rawData.get('first')?.trim() || '';
    const lastName = rawData.get('last')?.trim() || '';
    const phone = rawData.get('phone')?.trim() || '';
    const email = rawData.get('email')?.trim() || '';
    const destination = rawData.get('destination') || '';
    const course = rawData.get('course') || '';
    const message = rawData.get('message')?.trim() || '';

    if (!firstName || !phone) {
      consultationStatus.style.display = 'block';
      consultationStatus.style.background = '#fff3cd';
      consultationStatus.style.color = '#856404';
      consultationStatus.textContent = 'Please fill in your name and phone number.';
      return;
    }

    consultationStatus.style.display = 'block';
    consultationStatus.style.background = '#e3f2fd';
    consultationStatus.style.color = '#1565c0';
    consultationStatus.textContent = 'Sending...';

    try {
      const response = await fetch('https://authentic-bracelet-0264bec354.strapiapp.com/api/contacts', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          data: {
            name: `${firstName} ${lastName}`.trim(),
            email: email,
            phone: phone,
            destination: destination,
            course: course,
            message: message,
          }
        }),
      });

      if (response.ok) {
        consultationStatus.style.background = '#e8f5e9';
        consultationStatus.style.color = '#2e7d32';
        consultationStatus.textContent = 'Thank you! We will call you back shortly.';
        consultationForm.reset();
      } else {
        throw new Error('Failed to submit');
      }
    } catch (error) {
      consultationStatus.style.background = '#fff3cd';
      consultationStatus.style.color = '#856404';
      consultationStatus.textContent = 'Server error. Please chat with us on WhatsApp instead.';
    }
  });
</script>
</MainLayout>

<style>
    /* Testimonials - Updated */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .testimonial-card {
    background: var(--primary-white);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--gray-200);
    transition: all var(--transition);
  }

  .testimonial-card:hover {
    border-color: var(--tertiary);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .testimonial-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .testimonial-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--tertiary);
    color: var(--primary-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
    letter-spacing: 1px;
  }

  .testimonial-stars {
    color: #f59e0b;
    font-size: 0.9rem;
    letter-spacing: 2px;
    margin-bottom: 0.15rem;
  }

  .testimonial-header strong {
    display: block;
    color: var(--secondary);
    font-size: 1rem;
  }

  .testimonial-dest {
    font-size: 0.8rem;
    color: var(--tertiary);
    font-weight: 500;
  }

  .testimonial-text {
    color: #555;
    line-height: 1.7;
    font-style: bold;
    position: relative;
    padding-left: 1.5rem;
  }

  .testimonial-text::before {
    content: '"';
    position: absolute;
    left: 0;
    top: -0.3rem;
    font-size: 2.5rem;
    color: var(--tertiary);
    opacity: 0.3;
    font-style: normal;
    line-height: 1;
  }
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--primary-white);
  }

  /* Background Image */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: blur(3px) brightness(0.6);
    transform: scale(1.05);
  }

  /* Dark Overlay */
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      160deg,
      rgba(36, 54, 120, 0.92) 0%,
      rgba(36, 54, 120, 0.85) 40%,
      rgba(101, 45, 144, 0.8) 100%
    );
    z-index: 1;
  }

  /* Content on top */
  .hero-grid {
    position: relative;
