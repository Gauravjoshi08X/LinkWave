---
import MainLayout from '../layouts/MainLayout.astro';
import { getCountryBySlug, getAllCountrySlugs } from '../data/countries.js';

export async function getStaticPaths() {
  return getAllCountrySlugs().map(slug => ({
    params: { country: slug }
  }));
}

const { country } = Astro.params;
const countryData = getCountryBySlug(country);

if (!countryData) {
  return Astro.redirect('/');
}

const displayName = countryData.name;
const description = `Comprehensive guide to studying in ${displayName}. Learn about top universities, visa requirements, costs, popular courses, and student life. Expert guidance from Link Wave Global Study.`;

function getBenefitDescription(benefit, country) {
  const descriptions = {
    'Globally recognized qualifications and degrees': `${country} degrees are respected worldwide. graduates find their qualifications valued by employers and institutions across the globe, opening doors to international careers.`,
    'Post-study work rights up to 4 years': `After completing your studies, you can stay and work in ${country}, gaining valuable international experience. This is a major advantage for students looking to build a global career.`,
    'Part-time work allowed during studies': `As an international student, you can work part-time while studying, helping you manage living expenses and gain practical experience in ${country}'s job market.`,
    'Safe and welcoming multicultural society': `${country} is home to students from all over the world. students find a warm, inclusive environment with established communities and strong support networks.`,
    'Stunning natural landscapes and high quality of life': `Beyond academics, ${country} offers an exceptional quality of life. From vibrant cities to breathtaking nature, it's an enriching experience for students.`,
    'Strong economy with excellent job prospects': `${country}'s robust economy creates numerous opportunities for graduates. Sectors like technology, healthcare, and engineering actively seek international talent.`,
    'World-renowned universities with centuries of academic tradition': `Institutions in ${country} have shaped global education for generations. students benefit from world-class teaching, research facilities, and prestigious alumni networks.`,
    'Shorter course duration saves time and money': `Programs in ${country} are typically shorter than in other destinations. students can complete their studies faster, reducing both tuition fees and living costs.`,
    '2-year post-study work visa': `The Graduate Route allows students to work in ${country} for up to 2 years after graduation, providing a pathway to international work experience.`,
    'Access to world-class research facilities': `${country} invests heavily in research and innovation. Students get hands-on experience with cutting-edge technology and work alongside leading researchers.`,
    'Rich cultural heritage and diverse student life': `Studying in ${country} means immersing yourself in a rich cultural experience. students enjoy a vibrant campus life and exposure to diverse perspectives.`,
    'NHS healthcare access for international students': `International students in ${country} can access the national healthcare system, ensuring peace of mind for families concerned about their children's wellbeing abroad.`,
    'Clear pathway to Permanent Residency': `Many students choose ${country} because of its clear immigration pathways. Your study journey can be the first step toward long-term settlement.`,
    'Affordable tuition fees compared to US/UK': `${country} offers world-class education at more accessible costs. This makes it an attractive option for families seeking quality education within budget.`,
    'Post-Graduation Work Permit up to 3 years': `Graduates can work in ${country} for up to 3 years after completing their studies. This provides ample time for students to gain meaningful work experience.`,
    'Bilingual country': `As a bilingual nation, ${country} offers students the unique opportunity to learn an additional language while studying, enhancing their global employability.`,
    'Co-op and internship opportunities': `${country}'s education system emphasizes practical learning. students gain real-world experience through paid internships integrated into their programs.`,
    'All 8 universities in global top 3%': `Despite its small size, ${country} punches above its weight in education. students receive quality education at globally recognized institutions.`,
    'Safe and politically stable country': `${country} is consistently ranked among the safest countries in the world. parents can rest assured about their children's security.`,
    'Affordable living cost in many regions': `Compared to other English-speaking destinations, ${country} offers a more affordable cost of living, making it accessible for middle-class families.`,
    'Largest number of top-ranked universities globally': `With thousands of institutions, ${country} offers unmatched variety. students can find programs perfectly matched to their interests and career goals.`,
    'Flexible education system': `The ${country} education system allows students to explore different subjects before declaring a major. This flexibility helps students discover their true passion.`,
    'Optional Practical Training (OPT) up to 3 years for STEM': `STEM graduates from backgrounds can work in ${country} for up to 3 years after graduation, gaining invaluable experience in their field.`,
    'Extensive scholarship and funding opportunities': `${country} institutions offer generous scholarships. Link Wave helps students identify and secure these financial aid opportunities.`,
    'Diverse campus life and cultural experiences': `Campuses in ${country} are melting pots of cultures. students make friends from around the world and build lifelong international networks.`,
  };

  return descriptions[benefit] || `${benefit} - This is one of the key advantages of studying in ${country} that students greatly benefit from during their international education journey.`;
}
---

<MainLayout
  title={`Study in ${displayName} | Complete Guide ${new Date().getFullYear()} | Link Wave`}
  description={description}
>
  <!-- Hero -->
  <section class="country-hero">
    <div class="hero-banner">
      <img 
        src={countryData.banner} 
        alt={`Study in ${displayName}`}
        class="banner-image"
      />
    </div>
    <div class="hero-overlay">
      <div class="container">
        <div class="hero-content">
          <h1 class="reveal">
            Study in
            {displayName}
          </h1>
          <p class="hero-subtitle reveal">{countryData.whyStudy}</p>
          <div class="quick-facts reveal">
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="fact-label">Capital</span>
              <span class="fact-value">{countryData.capital}</span>
            </div>
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="6" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="fact-label">Currency</span>
              <span class="fact-value">{countryData.currency}</span>
            </div>
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
              <span class="fact-label">Languages</span>
              <span class="fact-value">{countryData.languages}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Study Here -->
  <section class="section">
    <div class="container">
      <div class="why-study reveal">
        <h2>Why {displayName} is a Great Choice for Nepali Students</h2>
        
        <div class="accordion-list" id="accordionList">
          {countryData.benefits.map((benefit, i) => (
            <div class="accordion-item">
              <button class="accordion-header" data-index={i}>
                <span class="accordion-title">{benefit}</span>
                <span class="accordion-icon">+</span>
              </button>
              <div class="accordion-body">
                <p>{getBenefitDescription(benefit, displayName)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Education System -->
  <section class="section bg-light">
    <div class="container">
      <h2 class="section-title reveal">Education System in {displayName}</h2>
      <div class="info-card reveal">
        <p>{countryData.educationSystem}</p>
      </div>

      <h3 class="reveal" style="margin-top: 2.5rem; text-align: center;">Top Universities & Rankings</h3>
      <div class="universities-grid reveal">
        {countryData.topUniversities.map((uni) => (
          <a href={uni.url} target="_blank" rel="noopener noreferrer" class="uni-card">
            {uni.image ? (
              <div class="uni-card-bg" style={`background-image: url('${uni.image}')`}></div>
            ) : (
              <div class="uni-card-placeholder"></div>
            )}
            <div class="uni-card-overlay"></div>
            <div class="uni-card-content">
              <div class="uni-rank-badge">#{uni.rank}</div>
              <span class="uni-name">{uni.name}</span>
            </div>
          </a>
        ))}
      </div>

      <h3 class="reveal" style="margin-top: 2.5rem; text-align: center;">Popular Courses</h3>
      <div class="courses-grid reveal">
        {countryData.popularCourses.map((course) => (
          <span class="course-tag">{course}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Cost & Visa -->
  <section class="section">
    <div class="container">
      <div class="two-col-grid">
        <div class="reveal">
          <h2>Cost of Studying</h2>
          <div class="cost-card">
            <div class="cost-item">
              <span class="cost-label">Tuition Fees</span>
              <span class="cost-value">{countryData.tuitionFees}</span>
            </div>
            <div class="cost-item">
              <span class="cost-label">Living Expenses</span>
              <span class="cost-value">{countryData.costOfLiving}</span>
            </div>
          </div>
        </div>

        <div class="reveal">
          <h2>Visa Requirements</h2>
          <div class="info-card">
            <p>{countryData.visaRequirements}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Process -->
  <section class="section bg-light">
    <div class="container">
      <h2 class="section-title reveal">Application Process</h2>
      <div class="process-timeline reveal">
        {countryData.process.map((step, i) => (
          <div class="process-step">
            <div class="step-number">{i + 1}</div>
            <div class="step-content">
              <p>{step}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-dark">
    <div class="container reveal">
      <h2>Start Your Journey to {displayName}</h2>
      <p>Let our expert counselors guide you through every step of the application process</p>
      <div class="cta-buttons">
        <a href="/LinkWave/contact-us" class="btn btn-gold">Get Free Consultation</a>
        <a href="tel:+9779851410481" class="btn btn-outline-white">Call +977 9851410481</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero */
    /* Hero with Banner */
