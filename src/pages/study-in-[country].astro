---
import MainLayout from '../layouts/MainLayout.astro';
import { getCountryBySlug, getAllCountrySlugs } from '../data/countries.js';

export async function getStaticPaths() {
  return getAllCountrySlugs().map(slug => ({
    params: { country: slug }
  }));
}

const { country } = Astro.params;
const countryData = getCountryBySlug(country);

if (!countryData) {
  return Astro.redirect('/');
}

const displayName = countryData.name;
const description = `Comprehensive guide to studying in ${displayName}. Learn about top universities, visa requirements, costs, popular courses, and student life. Expert guidance from Link Wave Global Study.`;
---

<MainLayout
  title={`Study in ${displayName} | Complete Guide 2026 | Link Wave`}
  description={description}
>
  <!-- Hero -->
  <section class="country-hero">
    <div class="hero-banner">
      <img 
        src={countryData.banner || '/images/banners/placeholder.jpg'} 
        alt={`Study in ${displayName}`}
        class="banner-image"
        onerror="this.src='/images/banners/placeholder.jpg'"
      />
    </div>
    <div class="hero-overlay">
      <div class="container">
        <div class="hero-content">
          <span class="continent-badge reveal">{countryData.continent}</span>
          <h1 class="reveal">
            Study in
            {displayName}
          </h1>
          <p class="hero-subtitle reveal">{countryData.whyStudy}</p>
          <div class="quick-facts reveal">
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="fact-label">Capital</span>
              <span class="fact-value">{countryData.capital}</span>
            </div>
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="6" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="fact-label">Currency</span>
              <span class="fact-value">{countryData.currency}</span>
            </div>
            <div class="fact">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
              <span class="fact-label">Languages</span>
              <span class="fact-value">{countryData.languages}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Study Here -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Why Study in {displayName}?</h2>
      
      <div class="benefits-grid reveal">
        {countryData.benefits.map((benefit) => (
          <div class="benefit-item">
            <span class="benefit-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span>{benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education System -->
  <section class="section bg-light">
    <div class="container">
      <h2 class="section-title reveal">Education System in {displayName}</h2>
      <div class="info-card reveal">
        <p>{countryData.educationSystem}</p>
      </div>

      <h3 class="reveal" style="margin-top: 2.5rem; text-align: center;">Top Universities & Rankings</h3>
      <div class="universities-grid reveal">
        {countryData.topUniversities.map((uni) => (
          <a href={uni.url} target="_blank" rel="noopener noreferrer" class="uni-card">
            <div class="uni-rank-badge">#{uni.rank}</div>
            <div class="uni-info">
              <span class="uni-name">{uni.name}</span>
              <span class="uni-rank-label">Global Rank</span>
            </div>
            <span class="uni-arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </span>
          </a>
        ))}
      </div>

      <h3 class="reveal" style="margin-top: 2.5rem; text-align: center;">Popular Courses</h3>
      <div class="courses-grid reveal">
        {countryData.popularCourses.map((course) => (
          <span class="course-tag">{course}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Cost & Visa -->
  <section class="section">
    <div class="container">
      <div class="two-col-grid">
        <div class="reveal">
          <h2>Cost of Studying</h2>
          <div class="cost-card">
            <div class="cost-item">
              <span class="cost-label">Tuition Fees</span>
              <span class="cost-value">{countryData.tuitionFees}</span>
            </div>
            <div class="cost-item">
              <span class="cost-label">Living Expenses</span>
              <span class="cost-value">{countryData.costOfLiving}</span>
            </div>
          </div>
        </div>

        <div class="reveal">
          <h2>Visa Requirements</h2>
          <div class="info-card">
            <p>{countryData.visaRequirements}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Process -->
  <section class="section bg-light">
    <div class="container">
      <h2 class="section-title reveal">Application Process</h2>
      <div class="process-timeline reveal">
        {countryData.process.map((step, i) => (
          <div class="process-step">
            <div class="step-number">{i + 1}</div>
            <div class="step-content">
              <p>{step}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-dark">
    <div class="container reveal">
      <h2>Start Your Journey to {displayName}</h2>
      <p>Let our expert counselors guide you through every step of the application process</p>
      <div class="cta-buttons">
        <a href="/contact-us" class="btn btn-gold">Get Free Consultation</a>
        <a href="tel:+9779851410481" class="btn btn-outline-white">Call +977 9851410481</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero */
    /* Hero with Banner */
  .country-hero {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    color: var(--primary-white);
    display: flex;
    align-items: center;
  }

  .hero-banner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: relative;
    width: 100%;
    min-height: 500px;
    background: linear-gradient(
      135deg, 
      rgba(36, 54, 120, 0.85) 0%, 
      rgba(36, 54, 120, 0.7) 40%,
      rgba(101, 45, 144, 0.6) 100%
    );
    z-index: 2;
    display: flex;
    align-items: center;
    padding: 4rem 0;
  }

  .hero-content {
    max-width: 800px;
    position: relative;
    z-index: 3;
  }

  .continent-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-content h1 {
    color: var(--primary-white);
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    word-break: break-word;
  }

  .flag-display {
    display: inline-block;
    vertical-align: middle;
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    opacity: 0.95;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 700px;
  }

  .quick-facts {
    display: flex;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    flex-wrap: wrap;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .fact svg {
    opacity: 0.7;
    margin-bottom: 0.35rem;
  }

  .fact-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.75;
  }

  .fact-value {
    font-weight: 700;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .country-hero {
      min-height: auto;
    }

    .hero-overlay {
      min-height: auto;
      padding: 3rem 0;
    }

    .hero-content h1 {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .quick-facts {
      gap: 1rem;
      padding-top: 1rem;
    }

    .fact {
      min-width: 80px;
    }

    .fact-value {
      font-size: 0.9rem;
    }
  }
  /* Sections */
  .section {
    padding: 5rem 0;
  }

  .bg-light {
    background: var(--gray-100);
  }

  .section-title {
    text-align: center;
    margin-bottom: 2rem;
    color: var(--secondary);
  }

  .lead-text {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 1.15rem;
    color: #555;
    line-height: 1.7;
  }

  /* Benefits */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--primary-white);
    border-radius: 8px;
    border: 1px solid var(--gray-200);
    transition: all var(--transition);
  }

  .benefit-item:hover {
    border-color: var(--tertiary);
    box-shadow: 0 2px 8px rgba(101, 45, 144, 0.08);
  }

  .benefit-icon {
    color: var(--tertiary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Info Card */
  .info-card {
    background: var(--primary-white);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--gray-200);
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Universities */
    .universities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    max-width: 900px;
    margin: 1rem auto 0;
  }

  .uni-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--primary-white);
    padding: 1.25rem;
    border-radius: 12px;
    border: 2px solid var(--gray-200);
    text-decoration: none;
    color: var(--text-dark);
    transition: all var(--transition);
    cursor: pointer;
  }

  .uni-card:hover {
    border-color: var(--tertiary);
    box-shadow: 0 8px 24px rgba(101, 45, 144, 0.12);
    transform: translateY(-3px);
  }

  .uni-rank-badge {
    width: 48px;
    height: 48px;
    background: var(--secondary);
    color: var(--primary-white);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .uni-card:hover .uni-rank-badge {
    background: var(--tertiary);
  }

  .uni-info {
    flex: 1;
    min-width: 0;
  }

  .uni-name {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--secondary);
    margin-bottom: 0.2rem;
  }

  .uni-rank-label {
    font-size: 0.75rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .uni-arrow {
    color: #ccc;
    flex-shrink: 0;
    transition: all var(--transition);
  }

  .uni-card:hover .uni-arrow {
    color: var(--tertiary);
    transform: translateX(3px);
  }

  /* Courses */
  .courses-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 900px;
    margin: 1rem auto 0;
    justify-content: center;
  }

  .course-tag {
    background: var(--primary-white);
    color: var(--tertiary);
    padding: 0.5rem 1.25rem;
    border-radius: 25px;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid var(--gray-200);
    transition: all var(--transition);
  }

  .course-tag:hover {
    background: var(--tertiary);
    color: var(--primary-white);
    border-color: var(--tertiary);
  }

  /* Two Column */
  .two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .two-col-grid h2 {
    margin-bottom: 1.5rem;
  }

  /* Cost Card */
  .cost-card {
    background: var(--gray-100);
    padding: 2rem;
    border-radius: 12px;
  }

  .cost-item {
    margin-bottom: 1.5rem;
  }

  .cost-item:last-child {
    margin-bottom: 0;
  }

  .cost-label {
    display: block;
    font-size: 0.85rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.35rem;
  }

  .cost-value {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--secondary);
  }

  /* Process Timeline */
  .process-timeline {
    max-width: 600px;
    margin: 0 auto;
  }

  .process-step {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    position: relative;
  }

  .process-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.35rem;
    top: 2.5rem;
    height: calc(100% + 1rem);
    width: 2px;
    background: var(--gray-200);
  }

  .step-number {
    width: 2.75rem;
    height: 2.75rem;
    background: var(--tertiary);
    color: var(--primary-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .step-content {
    background: var(--primary-white);
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--gray-200);
    flex: 1;
  }

  .step-content p {
    margin: 0;
    line-height: 1.6;
  }

  /* CTA Dark */
  .cta-dark {
    background: var(--secondary);
    color: var(--primary-white);
    padding: 4rem 0;
    text-align: center;
  }

  .cta-dark h2 {
    color: var(--primary-white);
    margin-bottom: 0.75rem;
  }

  .cta-dark p {
    opacity: 0.9;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-gold {
    background: #ffd700;
    color: var(--secondary);
    padding: 0.85rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: all var(--transition);
    border: none;
    cursor: pointer;
  }

  .btn-gold:hover {
    background: #ffe44d;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
  }

  .btn-outline-white {
    border: 2px solid var(--primary-white);
    color: var(--primary-white);
    padding: 0.85rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: all var(--transition);
  }

  .btn-outline-white:hover {
    background: var(--primary-white);
    color: var(--secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .two-col-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .quick-facts {
      flex-direction: column;
      gap: 1rem;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .hero-content h1 {
      font-size: 2rem;
    }
  }
</style>