  }

  .lead-text {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 1.15rem;
    color: #555;
    line-height: 1.7;
  }

  /* Benefits */
  .why-study {
    max-width: 750px;
    margin: 0 auto;
  }

  .why-study h2 {
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }

